@page "/producto/nuevo"
@inject NavigationManager navigationManager

<h3>Formulario Producto</h3>

<div class="text-center">
    <button class="btn btn-success" @onclick="regresar">
        Regresar
    </button>
</div>

@code {
    private async Task regresar()
    {
        navigationManager.NavigateTo("/producto");
    }
}